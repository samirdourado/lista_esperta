# Copie para .env.local. Só variáveis NEXT_PUBLIC_* chegam ao navegador.

# API NestJS, usada pelo navegador
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
# API vista pelo servidor do Next (proxy.ts). No Docker o compose define http://api:3333/api/v1.
# Se ficar vazia, usa NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
# Maps JavaScript API, restrita por domínio (fase 4)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# --- Protótipo do hackathon (removido quando a API Nest assumir; ver docs/DECISIONS.md D-009) ---
# Leitura de foto da lista em app/api/lists/parse (servidor do Next)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
