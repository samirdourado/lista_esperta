# Copie para .env.local e preencha. Nunca commite .env.local.
# Detalhes de cada variável: docs/05-roadmap-mvp-riscos-demo.md (seção 5.1)

# Banco (Cloud SQL Postgres + PostGIS ou Supabase)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lista_esperta

# Google Gemini (IDs de modelo vêm de env para trocar sem mudar código)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
GEMINI_MODEL_PRO=

# Google Maps Platform
# Server: Places API (New) + Routes API — restrinja por API
GOOGLE_MAPS_SERVER_KEY=
# Browser: Maps JavaScript API — restrinja por HTTP referrer
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Firecrawl
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
FIRECRAWL_API_KEY=

# Vigil Labs (camada preditiva)
VIGIL_API_URL=
VIGIL_API_KEY=
# vigil | heuristic | mock
FORECAST_PROVIDER=mock

# true = base semeada + respostas determinísticas (rede de segurança da demo)
DEMO_MODE=true
