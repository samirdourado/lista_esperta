# Copie para .env.local. Só variáveis NEXT_PUBLIC_* chegam ao navegador.

# API NestJS, usada pelo navegador
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
# API vista pelo servidor do Next (proxy.ts). No Docker o compose define http://api:3333/api/v1.
# Se ficar vazia, usa NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Deploy (Vercel + Render). Endereço do back, sem /api/v1, por exemplo
# https://lista-esperta-api.onrender.com. O front repassa /api/v1 e /uploads
# para ele, e as duas variáveis acima passam a apontar para o próprio front:
#   NEXT_PUBLIC_API_URL=https://frontlistaesperta.vercel.app/api/v1
#   API_INTERNAL_URL=https://lista-esperta-api.onrender.com/api/v1
# API_PROXY_TARGET=
