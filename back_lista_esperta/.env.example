PORT=3333
# dentro do Docker use o host "db" e a porta 5432; rodando local, localhost:5433
DATABASE_URL=postgresql://lista:lista@localhost:5433/lista_esperta?schema=public
FRONTEND_URL=http://localhost:3000

# Obrigatórios. Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Opcionais (padrões: 900 s, 7 dias, secure só em produção)
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_DAYS=7
# COOKIE_SECURE=false

# Senha das contas demo criadas por `npm run db:seed` (padrão: lista-esperta-dev)
# SEED_PASSWORD=

# Mapas gratuitos (docs/DECISIONS.md D-031). Todos têm padrão; mude só se precisar.
# Espelhos do Overpass (OpenStreetMap), separados por vírgula, tentados em ordem
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# BRASILAPI_URL=https://brasilapi.com.br/api
# Identificação enviada aos serviços públicos (sem dados pessoais)
# HTTP_USER_AGENT=ListaEsperta/0.1
# Importação de lojas do OpenStreetMap em segundo plano e validade do cache
# DISCOVERY_ENABLED=true
# DISCOVERY_TTL_DAYS=30
# Código de barras → produto (gratuito, sem chave)
# OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org
# URL pública da API, para montar links de fotos enviadas, e pasta dos uploads
# PUBLIC_URL=http://localhost:3333
# UPLOADS_DIR=uploads

# Não usado: o projeto segue com mapas gratuitos. Só para trocar pelo Google no futuro.
GOOGLE_MAPS_API_KEY=
# Leitura de foto de nota e normalização de produtos (plano gratuito em https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite
# Rotas reais para o veredito (gratuita em https://openrouteservice.org/dev/#/signup).
# Sem ela, a distância é estimada: linha reta × 1,3 a 25 km/h.
ORS_API_KEY=
# ORS_URL=https://api.openrouteservice.org
# Divisão em duas lojas só quando economiza mais que R$ 10 e mais que 5% do total
# VERDICT_SPLIT_MIN_SAVINGS=10
# VERDICT_SPLIT_MIN_SHARE=0.05
# fase 8, opcional
FIRECRAWL_API_KEY=
# consulta por chave quando houver captcha, opcional
NFCE_PROVIDER_API_KEY=
