PORT=3333
# dentro do Docker use o host "db" e a porta 5432; rodando local, localhost:5433
DATABASE_URL=postgresql://lista:lista@localhost:5433/lista_esperta?schema=public
FRONTEND_URL=http://localhost:3000

# Obrigatórios. Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Opcionais (padrões: 900 s, 7 dias, secure só em produção)
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_DAYS=7
# COOKIE_SECURE=false

# Senha das contas demo criadas por `npm run db:seed` (padrão: lista-esperta-dev)
# SEED_PASSWORD=

# Places API (New) + Routes API, uso no servidor
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
# fase 8, opcional
FIRECRAWL_API_KEY=
# consulta por chave quando houver captcha, opcional
NFCE_PROVIDER_API_KEY=
